# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server-only
# App
NEXT_PUBLIC_APP_URL=                # ex: https://fame.example
# Intégrations (server-only)
DROPBOX_ACCESS_TOKEN=
RESEND_API_KEY=
EMAIL_FROM=                         # ex: FAME <no-reply@fame.example>
REPORT_EMAIL=                       # destinataire des signalements « Signaler un problème » (server-only)
# Seed admin (npm run seed:admin)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# --- Assistant RAG (server-only) ---
OPENAI_API_KEY=
ASSISTANT_EMBED_MODEL=text-embedding-3-large
ASSISTANT_MODEL=gpt-4o-mini
ASSISTANT_SIMILARITY_THRESHOLD=0.35
ASSISTANT_MONTHLY_BUDGET_USD=50
ASSISTANT_IP_SALT=                   # server-only — pepper du hash IP (poser une valeur en prod)
# Mettre à 1 pour couper l'assistant globalement (kill-switch d'urgence)
ASSISTANT_DISABLED=
# --- Research hub (server-only) ---
OPENALEX_MAILTO=                     # required by OpenAlex's "polite pool" — a real contact email
SEMANTIC_SCHOLAR_API_KEY=            # optional, raises the rate limit
CRON_SECRET=                         # Vercel Cron sends this as `Authorization: Bearer <value>`
RESEARCH_FAME_THRESHOLD=50           # 0-100, score at/above this → published
RESEARCH_SIM_LO=0.32                 # cosine similarity mapped to 0%
RESEARCH_SIM_HI=0.72                 # cosine similarity mapped to 100%
